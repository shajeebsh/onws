---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/ui/Hero.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import GradientCard from '../components/ui/GradientCard.astro';
import TrustBadges from '../components/interactive/TrustBadges.astro';
import TechStackShowcase from '../components/interactive/TechStackShowcase.astro';
import ComparisonMatrix from '../components/interactive/ComparisonMatrix.astro';
import SmartContactForm from '../components/forms/SmartContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Digital Infrastructure for Irish Business">
	<Navbar />
	<main>
		<Hero 
			title="Digital Infrastructure — for Irish Business"
			subtitle="From immersive 8K Streetview solutions to high-performance ERP & CRM systems, we bridge the gap between physical reality and digital scale."
			cta1={{ text: "Explore Streetview Solutions", href: "/streetview" }}
			cta2={{ text: "Discover ERP & CRM", href: "/solutions/erp" }}
		/>

		<section class="max-w-7xl mx-auto px-4 py-24">
			<TrustBadges />
		</section>

		<section class="py-24 bg-slate-on/5">
			<div class="max-w-7xl mx-auto px-4">
				<SectionHeader 
					title="Unified Business Intelligence"
					subtitle="Our proprietary ERP and CRM solutions are engineered specifically for the Irish regulatory and SME landscape."
					centered
				/>
				<div class="mt-16 bg-deep-navy/50 border border-slate-on/30 rounded-[3rem] p-8 md:p-16 shadow-2xl backdrop-blur-xl">
					<ComparisonMatrix />
				</div>
			</div>
		</section>

		<section class="py-24 overflow-hidden">
			<div class="max-w-7xl mx-auto px-4">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
					<div>
						<SectionHeader 
							title="Engineering Elite Performance"
							subtitle="We build with the world's most robust tech stacks to ensure your infrastructure scales without friction."
						/>
						<div class="space-y-8 text-slate-400">
							<p class="text-lg leading-relaxed italic">
								"Our engineering culture is rooted in precision. Whether it's processing 8K geospatial data or managing enterprise supply chains, we prioritize zero-failure architecture."
							</p>
							<div class="pt-8 border-t border-slate-on/30">
								<h4 class="text-white font-black uppercase tracking-widest text-sm mb-6">Our Core Stack</h4>
								<TechStackShowcase />
							</div>
						</div>
					</div>
					<div class="relative group">
						<div class="absolute -inset-1 bg-gradient-to-r from-ireland-emerald to-slate-on rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
						<div class="relative bg-deep-navy border border-slate-on/50 rounded-3xl p-10">
							<div class="flex items-center gap-4 mb-8">
								<div class="w-12 h-12 bg-ireland-emerald/10 rounded-xl flex items-center justify-center text-ireland-emerald">
									<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
									</svg>
								</div>
								<div>
									<h3 class="text-xl font-bold text-white tracking-tight">The OliveNoor Pedigree</h3>
									<p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Founding Experience: Google Management</p>
								</div>
							</div>
							<p class="text-slate-400 leading-relaxed mb-8">
								Rooted in global operational standards, OliveNoor provides the strategic technical resources and digital visibility Irish businesses need to compete internationally.
							</p>
							<div class="grid grid-cols-2 gap-4">
								<div class="bg-slate-on/10 p-4 rounded-2xl text-center">
									<span class="block text-2xl font-black text-white">802,991</span>
									<span class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">CRO Registered</span>
								</div>
								<div class="bg-slate-on/10 p-4 rounded-2xl text-center">
									<span class="block text-2xl font-black text-ireland-emerald">100%</span>
									<span class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">Irish Owned</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="py-24 bg-slate-on/5" id="contact">
			<div class="max-w-7xl mx-auto px-4">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">
					<div>
						<SectionHeader 
							title="Ready to Scale? — Let's Talk."
							subtitle="Whether you're planning a nationwide streetview project or upgrading your enterprise systems, our team is ready to assist."
						/>
						<div class="space-y-6">
							<GradientCard variant="emerald" class="border-dashed">
								<h4 class="text-white font-bold mb-2">Priority Flagging</h4>
								<p class="text-sm text-slate-400">Large-scale projects (>50km²) or enterprises with >50 employees receive immediate priority scheduling.</p>
							</GradientCard>
							<div class="flex items-center gap-6 text-slate-400">
								<div class="flex -space-x-2">
									{[1,2,3,4].map(i => (
										<div class="w-10 h-10 rounded-full border-2 border-deep-navy bg-slate-on/50 overflow-hidden flex items-center justify-center text-[10px] font-bold text-white">
											Team
										</div>
									))}
								</div>
								<p class="text-sm font-medium">Join 200+ Irish companies scaling with OliveNoor.</p>
							</div>
						</div>
					</div>
					<SmartContactForm />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
