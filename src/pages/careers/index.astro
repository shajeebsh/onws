---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/ui/Hero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import GradientCard from '../../components/ui/GradientCard.astro';
import RecruiterForm from '../../components/forms/RecruiterForm.astro';
import TechStackShowcase from '../../components/interactive/TechStackShowcase.astro';
import Footer from '../../components/Footer.astro';

const roles = [
  { title: 'Senior Software Engineer', type: 'Full-time / Remote', stack: 'Astro, Tailwind, Node.js, Python' },
  { title: 'Data Scientist (Geospatial)', type: 'Permanent / Dublin', stack: 'Python, PyTorch, GIS Core' },
  { title: 'Automation Test Lead', type: 'Contract / Hybrid', stack: 'Playwright, Jest, CI/CD' }
];
---

<Layout title="Careers — Join OliveNoor">
  <Navbar />
  <main>
    <Hero 
      title="Engineering — Your Digital Future"
      subtitle="Join an elite team building the next generation of Irish digital infrastructure. From processing 8K geospatial data to architecting enterprise scale systems."
      cta1={{ text: "View Open Roles", href: "#roles" }}
      cta2={{ text: "Recruiter Portal", href: "#recruiter" }}
      imageSrc="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2000"
    />

    <section class="py-24 max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div>
          <SectionHeader 
            title="Our Engineering — Culture & Ethos"
            subtitle="We don't just write code; we solve high-complexity problems for the Irish economy. Our team prioritizes performance, security, and architectural purity."
          />
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-ireland-emerald/10 rounded-lg flex items-center justify-center text-ireland-emerald shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A10.003 10.003 0 0014 20c8 0 8-11 8-11V5a2 2 0 00-2-2h-7a2 2 0 00-2 2v4" /></svg>
              </div>
              <p class="text-slate-400 text-sm leading-relaxed">
                <span class="text-white font-bold block mb-1">Modern Tech Stack</span>
                We use the latest tools that offer the best performance. Astro for frontend, Python/Node.js for core services, and AWS for global scale.
              </p>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-ireland-emerald/10 rounded-lg flex items-center justify-center text-ireland-emerald shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <p class="text-slate-400 text-sm leading-relaxed">
                <span class="text-white font-bold block mb-1">Remote-First Flexibility</span>
                Work from Dublin, Cork, or your home office. We focus on high-impact output rather than physical attendance.
              </p>
            </div>
          </div>
        </div>
        <GradientCard variant="slate">
          <TechStackShowcase />
        </GradientCard>
      </div>
    </section>

    <section id="roles" class="py-24 bg-slate-on/5">
      <div class="max-w-7xl mx-auto px-4">
        <SectionHeader 
          title="Open — Engineering Roles"
          subtitle="Join us in building the digital backbone of Ireland."
          centered
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
          {roles.map(role => (
            <div class="bg-deep-navy border border-slate-on/50 p-8 rounded-3xl hover:border-ireland-emerald/50 transition-all group relative overflow-hidden">
              <div class="absolute -right-4 -top-4 w-16 h-16 bg-ireland-emerald/5 rounded-full blur-xl group-hover:bg-ireland-emerald/20"></div>
              <h4 class="text-xl font-black text-white mb-2">{role.title}</h4>
              <p class="text-xs font-bold text-ireland-emerald uppercase tracking-widest mb-6">{role.type}</p>
              <div class="pt-6 border-t border-slate-on/30">
                <p class="text-[10px] text-slate-500 font-bold uppercase tracking-[0.2em] mb-3">Target Stack</p>
                <p class="text-xs text-slate-400 leading-relaxed italic">{role.stack}</p>
              </div>
              <button class="w-full mt-8 py-3 bg-slate-on/50 text-white font-bold rounded-xl hover:bg-ireland-emerald hover:text-deep-navy transition-all">
                Apply Now
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="recruiter" class="py-24">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">
          <div>
            <SectionHeader 
              title="Recruiter — Partnership Portal"
              subtitle="If you represent elite technical talent, please use our dedicated referral portal. We review every agency submission within 48 hours."
            />
            <div class="bg-slate-on/10 p-8 rounded-3xl border border-dashed border-slate-on/50">
              <h4 class="text-white font-bold mb-4 italic">Agency Guidelines</h4>
              <ul class="space-y-3 text-xs text-slate-400 leading-relaxed">
                <li>• CVs must include specific technical stack proficiency</li>
                <li>• No unsolicited cold calls (Please use portal)</li>
                <li>• Candidates must have valid EU work authorization</li>
                <li>• Standardized 48h SLA for candidate feedback</li>
              </ul>
            </div>
          </div>
          <RecruiterForm />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
