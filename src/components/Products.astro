---
---

<section id="products" class="py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">High-Performance <span class="text-ireland-emerald">SaaS</span> Solutions</h2>
      <p class="max-w-2xl mx-auto text-lg text-slate-400">
        Scalable software engineered to streamline operations and accelerate growth for the modern enterprise.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Product: OliveERP -->
      <div class="group relative bg-slate-on/20 border border-slate-on/50 rounded-3xl p-10 hover:bg-slate-on/30 transition-all">
        <div class="flex items-center justify-between mb-8">
          <div class="text-ireland-emerald font-bold text-4xl tracking-tighter">Olive<span class="text-white">ERP</span></div>
          <div class="bg-white/10 px-4 py-1 rounded-full text-xs font-semibold text-slate-300 uppercase tracking-widest">Scalable</div>
        </div>
        <p class="text-xl text-white mb-6">Unified Enterprise Resource Planning</p>
        <p class="text-slate-400 mb-8 leading-relaxed">
          The central nervous system for Irish SMEs. Manage finance, operations, and advanced reporting through a single, secure interface. Built for complexity, designed for clarity.
        </p>
        <div class="flex flex-wrap gap-3">
          {['Financial Control', 'Supply Chain', 'HR & Payroll', 'BI Reporting'].map(tag => (
            <span class="bg-deep-navy border border-slate-on/50 px-4 py-1.5 rounded-full text-sm text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      </div>
      
      <!-- Product: OliveCRM -->
      <div class="group relative bg-slate-on/20 border border-slate-on/50 rounded-3xl p-10 hover:bg-slate-on/30 transition-all">
        <div class="flex items-center justify-between mb-8">
          <div class="text-ireland-emerald font-bold text-4xl tracking-tighter">Olive<span class="text-white">CRM</span></div>
          <div class="bg-ireland-emerald/10 px-4 py-1 rounded-full text-xs font-semibold text-ireland-emerald uppercase tracking-widest">High-Velocity</div>
        </div>
        <p class="text-xl text-white mb-6">Customer Relationship Management</p>
        <p class="text-slate-400 mb-8 leading-relaxed">
          High-velocity CRM focused on automated lead generation and client retention. Stop losing leads and start building relationships that scale with your ambitions.
        </p>
        <div class="flex flex-wrap gap-3">
          {['Lead Automation', 'Pipeline Tracking', 'AI Insights', 'Email Integration'].map(tag => (
            <span class="bg-deep-navy border border-slate-on/50 px-4 py-1.5 rounded-full text-sm text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
