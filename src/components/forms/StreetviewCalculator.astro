---
---

<div class="bg-deep-navy border border-slate-on/50 rounded-3xl p-8 shadow-2xl overflow-hidden relative group">
  <div class="absolute -right-20 -top-20 w-64 h-64 bg-ireland-emerald/5 rounded-full blur-3xl group-hover:bg-ireland-emerald/10 transition-all duration-700"></div>
  
  <div class="relative z-10">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-12 h-12 bg-ireland-emerald/20 rounded-xl flex items-center justify-center text-ireland-emerald">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">Project Calculator</h3>
        <p class="text-sm text-slate-400 italic">Real-time estimate for Irish projects</p>
      </div>
    </div>

    <div class="space-y-8">
      <!-- Area Slider -->
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <label class="text-sm font-semibold text-slate-300">Coverage Area (km²)</label>
          <span class="text-ireland-emerald font-bold" id="area-val">10 km²</span>
        </div>
        <input 
          type="range" 
          min="0.1" 
          max="100" 
          step="0.1" 
          value="10" 
          class="w-full h-2 bg-slate-on/30 rounded-lg appearance-none cursor-pointer accent-ireland-emerald"
          id="area-slider"
        />
        <div class="flex justify-between text-[10px] text-slate-500 font-mono">
          <span>0.1 km²</span>
          <span>100 km²</span>
        </div>
      </div>

      <!-- Resolution Tiers -->
      <div class="space-y-4">
        <label class="text-sm font-semibold text-slate-300">Resolution Tier</label>
        <div class="grid grid-cols-3 gap-3">
          {['Standard', 'High', 'Ultra'].map((tier, i) => (
            <button 
              class={`py-2 px-3 rounded-xl border text-xs font-bold transition-all ${i === 1 ? 'bg-ireland-emerald text-deep-navy border-ireland-emerald' : 'bg-slate-on/20 text-slate-400 border-slate-on/50 hover:border-slate-400'}`}
              data-tier={tier.toLowerCase()}
              data-multiplier={i + 1}
            >
              {tier}
            </button>
          ))}
        </div>
      </div>

      <!-- Add-ons -->
      <div class="space-y-4">
        <label class="text-sm font-semibold text-slate-300">Optional Add-ons</label>
        <div class="grid grid-cols-1 gap-2">
          {[
            { id: 'drone', label: 'Drone Aerial Coverage (+25%)' },
            { id: 'interior', label: '360° Interior walkthroughs' },
            { id: 'timelapse', label: 'Timelapse monitoring' }
          ].map(addon => (
            <label class="flex items-center gap-3 p-3 bg-slate-on/10 border border-slate-on/30 rounded-xl cursor-pointer hover:bg-slate-on/20 transition-colors">
              <input type="checkbox" class="accent-ireland-emerald h-4 w-4" id={addon.id} />
              <span class="text-xs text-slate-300">{addon.label}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Output Display -->
      <div class="mt-10 pt-8 border-t border-slate-on/50">
        <div class="flex justify-between items-end mb-6">
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 font-bold mb-1">Estimated Investment</p>
            <p class="text-3xl font-bold text-white" id="total-price">€1,450.00</p>
          </div>
          <div class="text-right">
            <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 font-bold mb-1">Timeline</p>
            <p class="text-lg font-bold text-slate-300" id="total-timeline">4-6 Days</p>
          </div>
        </div>
        
        <button class="w-full py-4 bg-ireland-emerald text-deep-navy font-bold rounded-2xl hover:bg-emerald-400 transition-all hover:scale-[1.02] shadow-xl shadow-ireland-emerald/10">
          Book Survey Now
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const slider = document.getElementById('area-slider') as HTMLInputElement;
  const areaVal = document.getElementById('area-val');
  const totalPrice = document.getElementById('total-price');
  const totalTimeline = document.getElementById('total-timeline');
  const tierBtns = document.querySelectorAll('[data-tier]');
  
  let currentTierMultiplier = 2; // High by default

  function update() {
    const area = parseFloat(slider.value);
    if (areaVal) areaVal.innerText = `${area} km²`;
    
    // Base logic: 100 per km2 * tier multiplier
    let base = area * 100 * currentTierMultiplier;
    
    // Add-ons
    const drone = (document.getElementById('drone') as HTMLInputElement)?.checked;
    if (drone) base *= 1.25;
    
    if (totalPrice) {
      totalPrice.innerText = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR' }).format(base);
    }
    
    // Timeline logic
    const days = Math.ceil(area / 2) + 2;
    if (totalTimeline) totalTimeline.innerText = `${days}-${days + 2} Days`;
  }

  slider?.addEventListener('input', update);
  
  tierBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tierBtns.forEach(b => {
        b.classList.remove('bg-ireland-emerald', 'text-deep-navy', 'border-ireland-emerald');
        b.classList.add('bg-slate-on/20', 'text-slate-400', 'border-slate-on/50');
      });
      btn.classList.add('bg-ireland-emerald', 'text-deep-navy', 'border-ireland-emerald');
      btn.classList.remove('bg-slate-on/20', 'text-slate-400', 'border-slate-on/50');
      currentTierMultiplier = parseInt(btn.getAttribute('data-multiplier') || '2');
      update();
    });
  });

  ['drone', 'interior', 'timelapse'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', update);
  });
</script>
