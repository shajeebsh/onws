---
---

<div class="bg-slate-on/10 border border-slate-on/50 rounded-3xl p-8 backdrop-blur-md relative overflow-hidden group">
  <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-slate-on/20 rounded-full blur-3xl group-hover:bg-ireland-emerald/5 transition-all duration-700"></div>

  <div class="relative z-10">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-12 h-12 bg-slate-on/30 rounded-xl flex items-center justify-center text-ireland-emerald">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-white">ROI Estimator</h3>
        <p class="text-sm text-slate-400 italic">Projected annual savings for SMEs</p>
      </div>
    </div>

    <div class="space-y-6">
      <!-- Company Size -->
      <div class="space-y-3">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Company Size</label>
        <select id="roi-size" class="w-full bg-deep-navy border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:border-ireland-emerald outline-none transition-all">
          <option value="10">1-10 Employees</option>
          <option value="50" selected>11-50 Employees</option>
          <option value="200">51-200 Employees</option>
          <option value="500">200+ Employees</option>
        </select>
      </div>

      <!-- Current Spend -->
      <div class="space-y-3">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Current Monthly Spend (€)</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">€</span>
          <input 
            type="number" 
            id="roi-spend" 
            value="1200"
            class="w-full bg-deep-navy border border-slate-on/50 rounded-xl pl-8 pr-4 py-3 text-white focus:border-ireland-emerald outline-none transition-all"
          />
        </div>
      </div>

      <!-- Pain Points -->
      <div class="space-y-3">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Efficiency Blockers</label>
        <div class="grid grid-cols-1 gap-2">
          {[
            { id: 'manual', label: 'Manual data entry (High error rate)', weight: 0.15 },
            { id: 'silos', label: 'Disconnected systems / Data silos', weight: 0.2 },
            { id: 'reporting', label: 'Slow month-end reporting', weight: 0.1 }
          ].map(point => (
            <label class="flex items-center gap-3 p-3 bg-deep-navy/50 border border-slate-on/30 rounded-xl cursor-pointer hover:border-slate-400 transition-all">
              <input type="checkbox" class="roi-point accent-ireland-emerald h-4 w-4" data-weight={point.weight} checked />
              <span class="text-xs text-slate-300">{point.label}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Result Card -->
      <div class="mt-8 p-6 bg-ireland-emerald rounded-2xl text-deep-navy relative group/card">
        <div class="absolute inset-0 bg-white/10 opacity-0 group-hover/card:opacity-100 transition-opacity"></div>
        <div class="relative z-10">
          <p class="text-[10px] font-bold uppercase tracking-widest mb-1 opacity-70">Estimated Annual Recovery</p>
          <p class="text-4xl font-extrabold" id="roi-total">€24,450</p>
          <p class="text-[10px] mt-4 font-medium opacity-80 leading-relaxed italic">
            *Based on industry averages for operational efficiency gains through unified ERP/CRM implementation.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculateROI() {
    const size = parseInt((document.getElementById('roi-size') as HTMLSelectElement).value);
    const spend = parseFloat((document.getElementById('roi-spend') as HTMLInputElement).value) || 0;
    const points = document.querySelectorAll('.roi-point:checked');
    const totalEl = document.getElementById('roi-total');

    let efficiencyMultiplier = 0;
    points.forEach(p => {
      efficiencyMultiplier += parseFloat(p.getAttribute('data-weight') || '0');
    });

    // Simple ROI logic: (Monthly spend * 12) + (Size * Salary Savings Factor * efficiencyMultiplier)
    const annualSpend = spend * 12;
    const productivityGains = size * 45000 * efficiencyMultiplier * 0.1; // 10% of salary saved via efficiency
    const total = annualSpend * 0.3 + productivityGains; // 30% reduction in spend + productivity gains

    if (totalEl) {
      totalEl.innerText = new Intl.NumberFormat('en-IE', { 
        style: 'currency', 
        currency: 'EUR',
        maximumFractionDigits: 0
      }).format(total);
    }
  }

  ['roi-size', 'roi-spend'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateROI);
  });

  document.querySelectorAll('.roi-point').forEach(p => {
    p.addEventListener('change', calculateROI);
  });

  calculateROI();
</script>
