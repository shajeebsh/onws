---
---

<div class="bg-slate-on/10 border border-slate-on/50 p-10 rounded-3xl backdrop-blur-md">
  <form 
    name="recruiter-contact" 
    method="POST" 
    data-netlify="true" 
    netlify-honeypot="bot-field"
    enctype="multipart/form-data"
    class="space-y-6"
  >
    <input type="hidden" name="form-name" value="recruiter-contact" />
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Agency Name</label>
        <input type="text" name="agency" required class="w-full bg-deep-navy border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:border-ireland-emerald outline-none" placeholder="Recruiters Ltd" />
      </div>
      <div class="space-y-2">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Contact Email</label>
        <input type="email" name="email" required class="w-full bg-deep-navy border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:border-ireland-emerald outline-none" placeholder="agent@agency.com" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div class="space-y-2">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Role Type</label>
        <select name="role-type" class="w-full bg-deep-navy border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:border-ireland-emerald outline-none">
          <option value="permanent">Permanent</option>
          <option value="contract">Contract</option>
          <option value="both">Both</option>
        </select>
      </div>
      <div class="space-y-2">
        <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Seniority</label>
        <select name="seniority" class="w-full bg-deep-navy border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:border-ireland-emerald outline-none">
          <option value="junior">Junior / Associate</option>
          <option value="mid">Mid-Weight</option>
          <option value="senior" selected>Senior / Lead</option>
          <option value="exec">Exec / Principal</option>
        </select>
      </div>
    </div>

    <div class="space-y-2">
      <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">Target Tech Stack</label>
      <textarea name="tech-requirements" rows="3" class="w-full bg-deep-navy border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:border-ireland-emerald outline-none" placeholder="e.g. Node.js, Python, Astro, AWS..."></textarea>
    </div>

    <div class="space-y-2">
      <label class="text-xs font-bold text-slate-400 uppercase tracking-widest">CV / Documentation (Max 10MB)</label>
      <div class="flex items-center justify-center w-full">
        <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-slate-on/30 border-dashed rounded-xl cursor-pointer bg-deep-navy hover:bg-slate-on/10 transition-colors">
          <div class="flex flex-col items-center justify-center pt-5 pb-6">
            <svg class="w-8 h-8 mb-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="mb-2 text-sm text-slate-400"><span class="font-bold">Click to upload</span> or drag and drop</p>
            <p class="text-xs text-slate-500">PDF, DOCX (Multiple files supported)</p>
          </div>
          <input type="file" name="cv-files" class="hidden" multiple accept=".pdf,.doc,.docx" />
        </label>
      </div>
    </div>

    <button type="submit" class="w-full bg-slate-on text-white font-bold py-4 rounded-xl hover:bg-slate-600 transition-all border border-slate-500/30">
      Submit Agency Referral
    </button>
  </form>
</div>
