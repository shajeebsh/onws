---
const navLinks = [
  { name: 'Services', href: '#services' },
  { name: 'Products', href: '#products' },
  { name: 'Recruitment', href: '#recruitment' },
  { name: 'About', href: '#about' },
  { name: 'Contact', href: '#contact' },
];
---

<nav class="fixed top-0 w-full z-50 bg-deep-navy/80 backdrop-blur-md border-b border-slate-on/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink-0 flex items-center gap-2">
        <div class="w-8 h-8 bg-ireland-emerald rounded-lg flex items-center justify-center">
          <span class="text-deep-navy font-bold text-xl">O</span>
        </div>
        <span class="text-xl font-bold tracking-tight text-white">OliveNoor <span class="text-ireland-emerald">Limited</span></span>
      </div>
      
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="text-slate-300 hover:text-ireland-emerald px-3 py-2 rounded-md text-sm font-medium transition-colors"
            >
              {link.name}
            </a>
          ))}
          <a
            href="#contact"
            class="bg-ireland-emerald text-deep-navy px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-emerald-400 transition-all hover:scale-105"
          >
            Get Started
          </a>
        </div>
      </div>
      
      <div class="md:hidden">
        <!-- Mobile menu button - simplify for MVP -->
        <button type="button" class="text-slate-300 hover:text-white">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>
<div class="h-20"></div>
