---
const features = [
  { name: 'Industry modules', erp: true, crm: false },
  { name: 'Irish tax compliance', erp: true, crm: false },
  { name: 'Sales pipeline', erp: false, crm: true },
  { name: 'Customer service', erp: false, crm: true },
  { name: 'Custom reporting', erp: true, crm: true },
  { name: 'Inventory management', erp: true, crm: false },
  { name: 'Marketing automation', erp: false, crm: true },
];
---

<div class="overflow-x-auto">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b border-slate-on/50">
        <th class="py-6 px-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Capability</th>
        <th class="py-6 px-4 text-center">
          <span class="text-xl font-bold text-white tracking-tighter">Olive<span class="text-ireland-emerald">ERP</span></span>
        </th>
        <th class="py-6 px-4 text-center">
          <span class="text-xl font-bold text-white tracking-tighter">Olive<span class="text-ireland-emerald">CRM</span></span>
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-on/20">
      {features.map(f => (
        <tr class="group hover:bg-slate-on/5 transition-colors">
          <td class="py-5 px-4 text-slate-300 font-medium">{f.name}</td>
          <td class="py-5 px-4 text-center">
            {f.erp ? (
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-ireland-emerald/20 text-ireland-emerald">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            ) : (
              <span class="text-slate-600">—</span>
            )}
          </td>
          <td class="py-5 px-4 text-center">
            {f.crm ? (
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-ireland-emerald/20 text-ireland-emerald">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            ) : (
              <span class="text-slate-600">—</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
