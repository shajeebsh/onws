---
---

<section id="contact" class="py-24 bg-slate-on/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-8">Ready to Scale? <br /> <span class="text-ireland-emerald">Let's Talk.</span></h2>
        <p class="text-slate-400 text-lg mb-12">
          Whether you need precision geospatial data, enterprise software, or elite technical talent, we're here to deliver.
        </p>
        
        <div class="space-y-8">
          <div class="flex items-start gap-6">
            <div class="w-12 h-12 bg-ireland-emerald/10 rounded-xl flex items-center justify-center text-ireland-emerald shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-bold mb-1">Direct Inquiries</h3>
              <p class="text-slate-400">{import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@olivenoor.com'}</p>
            </div>
          </div>
          
          <div class="flex items-start gap-6">
            <div class="w-12 h-12 bg-ireland-emerald/10 rounded-xl flex items-center justify-center text-ireland-emerald shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-bold mb-1">HQ</h3>
              <p class="text-slate-400">Dublin, Ireland</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-deep-navy border border-slate-on/50 p-10 rounded-3xl shadow-2xl relative">
        <form name="contact" method="POST" data-netlify="true" class="space-y-6">
          <input type="hidden" name="form-name" value="contact" />
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="text-sm font-semibold text-slate-300">Name</label>
              <input type="text" id="name" name="name" required class="w-full bg-slate-on/20 border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-ireland-emerald transition-all" placeholder="John Doe" />
            </div>
            <div class="space-y-2">
              <label for="email" class="text-sm font-semibold text-slate-300">Email</label>
              <input type="email" id="email" name="email" required class="w-full bg-slate-on/20 border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-ireland-emerald transition-all" placeholder="john@example.com" />
            </div>
          </div>
          
          <div class="space-y-2">
            <label for="interest" class="text-sm font-semibold text-slate-300">Service of Interest</label>
            <select id="interest" name="interest" class="w-full bg-slate-on/20 border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-ireland-emerald transition-all appearance-none">
              <option value="software">Software Solutions (ERP/CRM)</option>
              <option value="geospatial">Geospatial / Street View</option>
              <option value="recruitment">Elite Recruitment</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div class="space-y-2">
            <label for="message" class="text-sm font-semibold text-slate-300">Message</label>
            <textarea id="message" name="message" rows="4" required class="w-full bg-slate-on/20 border border-slate-on/50 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-ireland-emerald transition-all" placeholder="How can we help?"></textarea>
          </div>
          
          <button type="submit" class="w-full bg-ireland-emerald text-deep-navy font-bold py-4 rounded-xl hover:bg-emerald-400 transition-all hover:scale-[1.02] shadow-lg shadow-ireland-emerald/20">
            Send Inquiry
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
