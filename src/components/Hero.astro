---
---

<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden py-24">
  <!-- Decorative background elements -->
  <div class="absolute top-0 left-0 w-full h-full -z-10">
    <div class="absolute top-[10%] left-[10%] w-[30%] h-[30%] bg-ireland-emerald/10 blur-[100px] rounded-full"></div>
    <div class="absolute bottom-[10%] right-[10%] w-[40%] h-[40%] bg-slate-on/20 blur-[120px] rounded-full"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center space-x-2 bg-slate-on/30 border border-slate-on/50 rounded-full px-4 py-1.5 mb-8">
      <span class="flex h-2 w-2 rounded-full bg-ireland-emerald animate-pulse"></span>
      <span class="text-sm font-medium text-slate-300">Enterprise Modern Standards</span>
    </div>
    
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white mb-6 leading-[1.1]">
      Bridging <span class="text-ireland-emerald">Tech Innovation</span>,<br />
      Geospatial Intelligence, <br class="hidden md:block" />
      and <span class="text-slate-400">Elite Talent</span>.
    </h1>
    
    <p class="max-w-3xl mx-auto text-lg md:text-xl text-slate-400 mb-12 leading-relaxed">
      OliveNoor Limited delivers 'Google-grade' precision in Street View imagery, robust ERP/CRM solutions, and high-impact recruitment for Ireland’s technology sector.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <a
        href="#products"
        class="w-full sm:w-auto px-8 py-4 bg-ireland-emerald text-deep-navy font-bold rounded-xl hover:bg-emerald-400 transition-all hover:scale-105 text-center shadow-lg shadow-ireland-emerald/20"
      >
        Explore Software
      </a>
      <a
        href="#services"
        class="w-full sm:w-auto px-8 py-4 bg-slate-on text-white font-bold rounded-xl hover:bg-slate-600 transition-all hover:scale-105 text-center border border-slate-500/30 shadow-xl"
      >
        Book a Virtual Tour
      </a>
      <a
        href="#recruitment"
        class="w-full sm:w-auto px-8 py-4 bg-transparent text-white font-bold rounded-xl hover:bg-white/5 transition-all text-center border border-white/20"
      >
        Find Talent
      </a>
    </div>
  </div>
</section>
