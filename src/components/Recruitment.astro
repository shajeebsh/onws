---
const pillars = [
  {
    title: 'Automation Testing',
    description: 'Specialists in building robust, CI/CD-integrated test frameworks that ensure zero-regression deployments.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4'
  },
  {
    title: 'Data Architect',
    description: 'Designing the blueprints for scalable data ecosystems that handle massive throughput with peak efficiency.',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
  },
  {
    title: 'Data Science',
    description: 'Transforming raw information into competitive advantages through predictive modeling and ML innovation.',
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'
  },
  {
    title: 'Software Developer',
    description: 'The architects of the digital world, proficient in building complex, distributed systems with precision.',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4'
  },
  {
    title: 'Data Analyst',
    description: 'Unlocking hidden patterns within complex datasets to drive data-driven decision making across the board.',
    icon: 'M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z'
  }
];
---

<section id="recruitment" class="py-24 bg-slate-on/10 border-y border-slate-on/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">High-Impact <span class="text-ireland-emerald">Technical Talent</span></h2>
      <p class="max-w-2xl text-lg text-slate-400">
        We source the architects of your digital future. Our recruitment division focuses on high-complexity roles where precision is non-negotiable.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {pillars.map((pillar) => (
        <div class="bg-deep-navy border border-slate-on/50 p-8 rounded-3xl group hover:border-ireland-emerald/50 transition-all">
          <div class="w-12 h-12 bg-slate-on/30 rounded-xl flex items-center justify-center mb-6 text-ireland-emerald group-hover:bg-ireland-emerald/10 transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={pillar.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-4 group-hover:text-ireland-emerald transition-colors">{pillar.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed italic">
            {pillar.description}
          </p>
        </div>
      ))}
      
      <!-- Call to Action Card -->
      <div class="bg-ireland-emerald/10 border-2 border-dashed border-ireland-emerald/30 p-8 rounded-3xl flex flex-col items-center justify-center text-center group">
        <h3 class="text-xl font-bold text-white mb-4">Need Elite Expertise?</h3>
        <p class="text-slate-400 text-sm mb-8">
          Join the ranks of leading Irish tech firms powered by OliveNoor talent.
        </p>
        <a href="#contact" class="px-6 py-3 bg-ireland-emerald text-deep-navy font-bold rounded-xl hover:bg-emerald-400 transition-all">
          Consult Our Team
        </a>
      </div>
    </div>
  </div>
</section>
