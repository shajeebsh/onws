---
interface Props {
  class?: string;
  variant?: 'emerald' | 'slate' | 'navy';
}

const { class: className, variant = 'slate' } = Astro.props;

const variants = {
  emerald: 'from-ireland-emerald/10 via-transparent to-transparent border-ireland-emerald/20',
  slate: 'from-slate-on/20 via-transparent to-transparent border-slate-on/50',
  navy: 'from-deep-navy via-transparent to-transparent border-slate-on/30'
};
---

<div class={`bg-slate-on/10 border bg-gradient-to-br ${variants[variant]} rounded-3xl p-8 backdrop-blur-sm hover:scale-[1.01] transition-all duration-300 ${className}`}>
  <slot />
</div>
