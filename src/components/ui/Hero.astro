---
interface Props {
  title: string;
  subtitle: string;
  cta1: { text: string; href: string };
  cta2: { text: string; href: string };
  imageSrc?: string;
}

const { title, subtitle, cta1, cta2, imageSrc = "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=2070" } = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden py-32 px-4 bg-brand-bg">
  <!-- Subtle Light Gradients -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-ireland-emerald/5 blur-[150px] rounded-full"></div>
    <div class="absolute bottom-0 left-1/4 w-[600px] h-[600px] bg-slate-200/50 blur-[180px] rounded-full"></div>
  </div>

  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16 relative z-10">
    <div class="flex-1 text-center lg:text-left">
      <div class="inline-flex items-center space-x-2 bg-white border border-brand-border rounded-full px-5 py-2 mb-8 shadow-sm">
        <span class="flex h-2.5 w-2.5 rounded-full bg-ireland-emerald"></span>
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Infrastructure for Scale</span>
      </div>
      
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight text-deep-navy mb-8 leading-[0.9] drop-shadow-sm">
        {title.split('—').map((part, i) => (
          <span class="block">
            {i === 1 ? <span class="text-ireland-emerald">{part}</span> : part}
          </span>
        ))}
      </h1>
      
      <p class="max-w-2xl mx-auto lg:mx-0 text-xl text-slate-500 mb-12 leading-relaxed font-medium">
        {subtitle}
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6">
        <a href={cta1.href} class="btn-primary w-full sm:w-auto">
          {cta1.text}
        </a>
        <a href={cta2.href} class="btn-secondary w-full sm:w-auto">
          {cta2.text}
        </a>
      </div>
    </div>

    <div class="flex-1 w-full lg:w-auto">
      <div class="relative group">
        <div class="absolute -inset-4 bg-gradient-to-tr from-ireland-emerald/20 to-slate-200/20 rounded-[2.5rem] blur-2xl opacity-50 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative rounded-[2rem] overflow-hidden shadow-2xl border-8 border-white">
          <img src={imageSrc} alt="Enterprise Infrastructure" class="w-full h-[500px] object-cover hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-deep-navy/40 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</section>
