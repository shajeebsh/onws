---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-brand-border py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 bg-ireland-emerald rounded-xl flex items-center justify-center shadow-lg shadow-ireland-emerald/20">
            <span class="text-white font-black text-2xl">O</span>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tighter text-deep-navy leading-none">OliveNoor</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-ireland-emerald mt-1">Limited</span>
          </div>
        </div>
        <p class="text-slate-500 max-w-sm mb-6 font-medium leading-relaxed">
          The technical foundation for Irish scale. Precision geospatial mapping, enterprise systems, and elite technical talent.
        </p>
      </div>
      
      <div>
        <h3 class="text-xs font-black uppercase tracking-[0.3em] text-slate-400 mb-8">Solutions</h3>
        <ul class="space-y-4 text-sm font-bold text-slate-500">
          <li><a href="/streetview" class="hover:text-ireland-emerald transition-colors uppercase tracking-widest">Streetview</a></li>
          <li><a href="/solutions/erp" class="hover:text-ireland-emerald transition-colors uppercase tracking-widest">OliveERP</a></li>
          <li><a href="/solutions/crm" class="hover:text-ireland-emerald transition-colors uppercase tracking-widest">OliveCRM</a></li>
          <li><a href="/careers" class="hover:text-ireland-emerald transition-colors uppercase tracking-widest">Careers</a></li>
        </ul>
      </div>
      
      <div>
        <h3 class="text-xs font-black uppercase tracking-[0.3em] text-slate-400 mb-8">Connect</h3>
        <ul class="space-y-4 text-sm font-bold text-slate-500">
          <li>Dublin, Ireland</li>
          <li>{import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@olivenoor.com'}</li>
          <li class="pt-4 flex gap-4">
            <a href="#" class="w-10 h-10 bg-slate-50 border border-brand-border rounded-full flex items-center justify-center hover:bg-ireland-emerald hover:text-white transition-all">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.238 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="pt-8 border-t border-brand-border flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-slate-400 text-xs font-bold uppercase tracking-widest">
        <p>OliveNoor Limited | Registered in Ireland | CRO: {import.meta.env.PUBLIC_COMPANY_CRO || '802991'}</p>
      </div>
      <div class="text-slate-400 text-xs font-bold uppercase tracking-widest">
        <p>&copy; {currentYear} OliveNoor Limited. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</footer>
