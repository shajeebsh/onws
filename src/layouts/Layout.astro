---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "OliveNoor Limited delivers 'Google-grade' precision in Street View imagery, robust ERP/CRM solutions, and high-impact recruitment for Ireland’s technology sector." } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | OliveNoor Limited</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<script is:inline>
			// Handle view transition script initialization
		</script>
		<style is:global>
			/* Custom scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				@apply bg-deep-navy;
			}
			::-webkit-scrollbar-thumb {
				@apply bg-slate-on rounded-full hover:bg-ireland-emerald transition-colors;
			}
		</style>
	</head>
	<body class="min-h-screen selection:bg-ireland-emerald selection:text-deep-navy">
		<slot />
	</body>
</html>
